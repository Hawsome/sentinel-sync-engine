DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_SOURCE=wp_source_db
DB_DEST=accounting_dest_db

# Optional: put the databases on separate servers (both default to DB_HOST)
# DB_SOURCE_HOST=
# DB_DEST_HOST=

# Optional: seconds a row must sit unchanged before it syncs (default 60).
# Must exceed the longest write transaction on the source.
# SYNC_LAG_SECONDS=60
